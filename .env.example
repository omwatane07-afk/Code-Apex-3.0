# CYBERQ Configuration
# Environment options: demo, pilot, production
CYBERQ_ENV=demo

# Server host & port
CYBERQ_HOST=127.0.0.1
CYBERQ_PORT=8000

# Database URL (SQLite in demo/local dev, PostgreSQL in pilot/production)
CYBERQ_DATABASE_URL=sqlite:///./cyberq_dev.db

# Secrets (auto-validated; in production, non-default 32-byte secret is required)
CYBERQ_SESSION_SECRET=dev-session-secret-change-in-production-must-be-32-bytes
CYBERQ_AUDIT_SIGNING_SEED=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
